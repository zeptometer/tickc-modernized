VPATH	= 	@srcdir@
INSTALL	=	@INSTALL@
CC	=	@CC@
TARGET	=	$(T_CPU)-$(T_OS)

gcc_include_dir = $(shell $(CC) -print-file-name=include)
gcc_driver =	$(CC)
d_other =	-D_TICKC_GCC_INCLUDE=\"$(gcc_include_dir)\" \
		-D_TICKC_LINK=\"$(gcc_driver)\"

CFLAGS	=	-g -O $(xdefs) $(d_other)

OBJS	=	tcc.o $(TARGET).o


install: tcc bprint
	$(INSTALL) tcc $(bindir)
	$(INSTALL) bprint $(bindir)

tcc:	$(OBJS)

$(TARGET).o: $(srcdir)/config/sys/$(TARGET).c
	$(CC) $(CFLAGS) -c $<

clean:
	rm -f *.o a.out core

dist-clean: clean
	rm -f bprint tcc
