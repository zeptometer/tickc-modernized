.PHONY: all current install clean dist-clean tilde-clean

TCC	=	1		# Tell relevant modules they are part of tcc
T_CPU	=	@target_cpu@
T_OSV	=	@target_os@
T_OS	=	$(strip $(patsubst ultrix%,ultrix,\
		$(patsubst sunos%,sunos,$(patsubst solaris%,solaris,\
		$(patsubst linux%,linux,$(patsubst openbsd%,openbsd,\
		$(T_OSV)))))))

ifneq (x86_64,$(T_CPU))
$(error Unsupported target CPU $(T_CPU); only x86_64 is maintained)
endif
ifneq (linux,$(T_OS))
$(error Unsupported target OS $(T_OS); only Linux is retained)
endif

VCODE_DIR = vcode-x86_64
VHDRS = vcode.h x86_64-codegen.h

srcs	=	lburg sup bpo $(VCODE_DIR) icode rts rcc copt tcc
EXESFX	=
VLIB	=	vcode.lib.a

# Set 'MODE' to 'optimize' to turn on full opts when compiling icode and in 
# other places where full opts are expensive
MODE	=	debug

cpp	=	yes
cc2	=	yes

prefix	=	@prefix@
srcdir	=	@srcdir@
ifeq ($(srcdir),.)
srcdir	=	$(prefix)
endif
builddir=	@prefix@/build
exec_prefix =	@exec_prefix@
bindir	=	@bindir@
includedir =	@includedir@/$(T_CPU)/$(T_OS)
libdir	=	@libdir@
infodir =	@infodir@
mandir	=	@mandir@

PERL	=	@PERL@
FIND	=	@FIND@
XARGS	=	@XARGS@
LN_S	=	@LN_S@
RM	=	@RM@ -f
MKDIR	=	@MKDIR@ -p
LNDIR	=	@LNDIR@
CC	=	@GCC@
AS	=	@AS@

d_prl	=	-D_TICKC_PRL=\"$(PERL)\"
d_bin	=	-D_TICKC_BIN=\"$(bindir)\"
d_lib	=	-D_TICKC_LIB=\"$(libdir)\"
d_inc	=	-D_TICKC_INC=\"$(includedir)\"
d_cpp	=	-D_TICKC_CPP=\"$(libdir)/cpp\"
d_com	=	-D_TICKC_COM=\"$(libdir)/rcc\"
d_cc2	=	-D_TICKC_CC2=\"$(libdir)/cc2\"
d_as	=	-D_TICKC_AS=\"$(AS)\"
d_bbx	=	-D_TICKC_BBX=\"$(libdir)/bbexit.o\"
xdefs	=	$(d_prl) $(d_bin) $(d_lib) $(d_inc) \
		$(d_cpp) $(d_com) $(d_cc2) $(d_as) $(d_bbx)

export T_CPU T_OS
export MODE
export TCC
export AS
export srcdir bindir libdir includedir
export xdefs

MAKEFLAGS=	-e

all: install

install:
	@root=`pwd`; notfound=0; \
	for dir in $(builddir) $(bindir) $(libdir); do \
		if [ ! -d $$dir ]; then \
			echo \# $$dir not found ; \
			notfound=1; \
		fi; \
	done; \
	if [ $$notfound = 1 ]; then \
		echo \# Please create these directories and rerun make. ; \
		exit; \
	fi; \
	if [ ! -d $(includedir) ]; then \
		echo \# Include dir \"$(includedir)\" not found: creating it; \
		$(MKDIR) $(includedir)/tickc; \
	fi; \
	if [ ! -d $(prefix)/tst ]; then \
		echo \# Test dir not found: creating $(prefix)/tst; \
		$(MKDIR) $(prefix)/tst; cd $(prefix)/tst; \
		$(LNDIR) $(srcdir)/tst; cd $$root; \
	fi; \
	ccom=$(CC); cname=system; \
	if [ $(cc2) = "yes" -a ! -f $(libdir)/cc2 ]; then \
		echo \# INSTALLING cc2: creating link to $$cname gcc ; \
		cc2=`$$ccom -print-prog-name=gcc`; \
		case $$cc2 in */*) ;; *) cc2=`command -v $$cc2`;; esac; \
		$(LN_S) $$cc2 $(libdir)/cc2 ; \
	fi; \
	if [ $(cpp) = "yes" -a ! -f $(libdir)/cpp ]; then \
		echo \# INSTALLING cpp: creating link to $$cname cpp ; \
		cpp=`$$ccom -print-prog-name=cpp`; \
		if [ ! -x "$$cpp" ]; then cpp=`command -v cpp`; fi; \
		echo Found cpp: $$cpp; \
		$(LN_S) $$cpp $(libdir)/cpp; \
	fi; \
	for p in $(srcs); do \
		echo \#; \
		echo \# BUILDING $$p for $(T_CPU)-$(T_OS); \
		echo \#; \
		if [ ! -d $(builddir)/$$p ]; then \
			$(MKDIR) $(builddir)/$$p; \
		fi; \
		cd $(builddir)/$$p; \
		if [ ! -f Makefile ]; then \
			if [ $$p = "$(VCODE_DIR)" ]; then \
				$(LN_S) $(srcdir)/src/$$p/* .; \
			else \
				$(srcdir)/src/$$p/configure \
					--srcdir=$(srcdir)/src/$$p \
					--prefix=$(srcdir) \
					--bindir=$(bindir) \
					--libdir=$(libdir) \
					--includedir=$(includedir); \
			fi; \
		fi; \
		$(MAKE) CC=$$ccom || exit $$?; \
		if [ $$p = "$(VCODE_DIR)" ]; then \
			cp $(VLIB) $(libdir)/libvcode.a; \
			cp $(VHDRS) $(includedir)/tickc; \
		fi; \
		cd $$root; \
		echo \# DONE; \
		echo \ ;\
	done;

clean:
	@for p in $(srcs); do \
		if [ -d $(builddir)/$$p ]; then \
			root=`pwd`; \
			cd $(builddir)/$$p; \
			$(MAKE) clean; \
			cd $$root; \
		fi; \
	done;

dist-clean:
	@for p in $(srcs); do \
		if [ -d $(builddir)/$$p ]; then \
			root=`pwd`; \
			cd $(builddir)/$$p; \
			$(MAKE) dist-clean; \
			$(RM) -r *; \
		fi; \
	done;

tilde-clean:
	@$(FIND) . -name "*~" | $(XARGS) $(RM)
