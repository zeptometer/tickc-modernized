extern int printf();

void cspec
mkscale(int **matrix, int size, int scale)
{
    return `{
        int row;
        int column;

        for (row = 0; row < $size; row++) {
            int *values = ($matrix)[row];

            for (column = 0; column < $size; column++)
                values[column] = values[column] * $scale;
        }
    };
}

int
main(void)
{
    int row0[3] = { 1, 2, 3 };
    int row1[3] = { 4, 5, 6 };
    int row2[3] = { 7, 8, 9 };
    int *matrix[3];
    void (*scale)();
    int row;
    int column;

    matrix[0] = row0;
    matrix[1] = row1;
    matrix[2] = row2;
    scale = compile(mkscale(matrix, 3, 4), void);
    (*scale)();
    for (row = 0; row < 3; row++) {
        for (column = 0; column < 3; column++)
            printf("%d%c", matrix[row][column], column == 2 ? '\n' : ' ');
    }
    decompile(scale);
    return 0;
}
