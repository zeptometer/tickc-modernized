AC_INIT(src/rcc/vcodex86.md)

AC_PREFIX_DEFAULT(`pwd`)
dnl Remember to set srcdir=$cwd

AC_CONFIG_AUX_DIR(config)
AC_CANONICAL_SYSTEM

if test "$target_cpu" != x86_64; then
  AC_MSG_ERROR([unsupported target CPU $target_cpu; only x86_64 is maintained])
fi
case "$target_os" in
  linux*) ;;
  *) AC_MSG_ERROR([unsupported target OS $target_os; only Linux is maintained]) ;;
esac

dnl Checks for programs.
AC_PATH_PROG(PERL, perl)
AC_PATH_PROG(FIND, find)
AC_PATH_PROG(XARGS, xargs)
AC_PATH_PROG(GCC, gcc)
AC_PATH_PROG(AS, as)
AC_PATH_PROG(RM, rm)
AC_PATH_PROG(MKDIR, mkdir)
AC_PATH_PROG(LNDIR, lndir)
AC_PROG_LN_S

AC_OUTPUT(./Makefile)
